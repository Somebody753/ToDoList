@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@model IEnumerable<ToDoList.Models.ChatGroup>


@{
    ViewData["Title"] = "Index";
}

@{var userId = UserManager.GetUserId(User);}

<h1>Index</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GroupName)
            </th>
            <th>

                <form asp-action="Create" method="get" style="display:inline">
                    <input type="hidden" />
                    <button type="submit" class="btn btn-outline-primary">
                        ➕ Create new group
                    </button>
                </form>


            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model) {

            bool isMember = group.GroupUsers.Any(u => u.UserId == userId);
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => group.GroupName)
                </td>
                <td>

                    


                    @if (!isMember)
                    {
                        <form asp-action="JoinGroup" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@group.Id" />
                            <button type="submit" class="btn btn-success" )">
                                Join
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Chat" asp-route-id="@group.Id" method="get" style="display:inline">
                            <button type="submit" class="btn btn-primary" )">
                                Chat and tasks
                            </button>
                        </form>
                    }

                    

                    


                    <form asp-action="Delete" asp-route-id="@group.Id" method="get" style="display:inline">
                        <button type="submit" class="btn btn-danger" )">
                            Delete
                        </button>
                    </form>
               



            </td>
        </tr>
}
    </tbody>
</table>
