@model ToDoList.Models.ToDoTask

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Task</h1>


<form asp-action="GroupTasks" asp-controller="ChatGroups" asp-route-id="@Model.ChatGroupId" method="get" style="display:inline">
    <button type="submit" class="btn btn-outline-light" )">
        Back to list
    </button>
</form>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="groupId" value="@Model.ChatGroupId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TaskName" class="control-label"></label>
                <input asp-for="TaskName" class="form-control" value=@Model.TaskName />
                <span asp-validation-for="TaskName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaskDetails" class="control-label"></label>
                <input asp-for="TaskDetails" class="form-control" value=@Model.TaskDetails />
                <span asp-validation-for="TaskDetails" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DeadlineDate" class="control-label"></label>
                <input asp-for="DeadlineDate" class="form-control" type="date" value=@Model.DeadlineDate />
                <span asp-validation-for="DeadlineDate" class="text-danger"></span>
            </div>


            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="TaskDone" /> @Html.DisplayNameFor(model => model.TaskDone)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
